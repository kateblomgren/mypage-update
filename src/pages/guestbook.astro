---
import '../styles/global.css'
import Layout from "../layouts/Layout.astro"

import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<Layout>

  <Header />

  <section class="max-w-2xl mx-auto py-20 px-6">

    <h1 class="text-4xl font-medium mb-6">Guestbook</h1>

    <p class="mb-10 text-lg">
      Leave a message, a thought, or a small trace of your visit ✨
    </p>

    <form 
      action="https://formspree.io/f/xzdkzdab" 
      method="POST"
      class="border-3 border-black p-6 bg-white relative"
    >

      <!-- corner decorations -->
      <div class="size-2 bg-white border-2 border-black absolute -top-2 -right-2"></div>
      <div class="size-2 bg-white border-2 border-black absolute -top-2 -left-2"></div>
      <div class="size-2 bg-white border-2 border-black absolute -bottom-2 -left-2"></div>
      <div class="size-2 bg-white border-2 border-black absolute -bottom-2 -right-2"></div>

      <div class="flex flex-col gap-6">

        <!-- Name + Link row -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

          <div class="flex flex-col gap-2">
            <label>Name</label>
            <input 
              type="text" 
              name="name" 
              placeholder="Your name"
              required
              class="border-2 border-black p-3"
            />
          </div>

          <div class="flex flex-col gap-2">
            <label>Link (optional)</label>
            <input 
              type="url" 
              name="link" 
              placeholder="https://..."
              class="border-2 border-black p-3"
            />
          </div>

        </div>

        <!-- Country select -->
        <div class="flex flex-col gap-2">
          <label>Country (for stamp)</label>
          <select name="country" required class="border-2 border-black p-3">
            <option value="">Select your country</option>
            <option>Ukraine</option>
            <option>Sweden</option>
            <option>Germany</option>
            <option>United States</option>
            <option>Canada</option>
            <option>United Kingdom</option>
            <option>France</option>
            <option>Italy</option>
            <option>Spain</option>
            <option>Netherlands</option>
            <option>Poland</option>
            <option>Australia</option>
            <option>New Zealand</option>
            <option>Japan</option>
            <option>South Korea</option>
            <option>Other</option>
          </select>
        </div>

        <!-- Message -->
        <div class="flex flex-col gap-2">
          <label>Message (max 150 chars)</label>
          <textarea 
            name="message" 
            placeholder="Write your message here..."
            maxlength="150"
            required
            rows="5"
            class="border-2 border-black p-3"
          ></textarea>
        </div>

        <button 
          type="submit"
          class="border-2 border-black px-6 py-3 bg-yellow-200 hover:-translate-y-1 transition"
        >
          Post Stamp
        </button>

      </div>

    </form>

  </section>

  <Footer />

</Layout>