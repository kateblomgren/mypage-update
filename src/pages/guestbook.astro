---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import { db, Guestbook, desc } from "astro:db";

// HANDLE FORM SUBMISSION
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const name = formData.get("name")?.toString().trim();
  const message = formData.get("message")?.toString().trim();
  const country = formData.get("country")?.toString().trim();
  const link = formData.get("link")?.toString().trim();

  if (!name || !message || !country) {
    return Astro.redirect("/guestbook?error=missing");
  }

  await db.insert(Guestbook).values({
    author: name,
    content: message,
    country,
    link: link || null,
    timestamp: new Date(),
  });

  return Astro.redirect("/guestbook?success=true");
}

// FETCH ENTRIES
const entries = await db
  .select()
  .from(Guestbook)
  .orderBy(desc(Guestbook.timestamp));
---

<Layout>
  <Header />

  <section class="max-w-2xl mx-auto py-16 px-6">

    <h1 class="text-4xl mb-6">Guestbook</h1>

    <!-- FORM -->
    <form method="POST" class="flex flex-col gap-4 border-2 border-black p-6">

      <input name="name" placeholder="Your name" required class="border p-2" />

      <input name="link" placeholder="Link (optional)" class="border p-2" />

      <select name="country" required class="border p-2">
        <option value="">Select country</option>
        <option>Ukraine</option>
        <option>Sweden</option>
        <option>Germany</option>
        <option>USA</option>
        <option>UK</option>
      </select>

      <textarea
        name="message"
        placeholder="Leave a message..."
        required
        maxlength="150"
        class="border p-2"
      ></textarea>

      <button type="submit" class="border-2 border-black p-2 bg-yellow-200">
        Sign guestbook
      </button>

    </form>

    <!-- ENTRIES -->
    <div class="mt-10 flex flex-col gap-4">

      {entries.map((entry) => (
        <div class="border-2 border-black p-4 bg-white">

          <strong>{entry.author}</strong>
          <p class="text-sm opacity-70">{entry.country}</p>
          <p class="mt-2">{entry.content}</p>

          {entry.link && (
            <a href={entry.link} target="_blank" class="text-blue-500 underline">
              link
            </a>
          )}

        </div>
      ))}

    </div>

  </section>

  <Footer />
</Layout>